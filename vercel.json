{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "baglamukhi-puja.in"
        }
      ],
      "destination": "https://www.baglamukhi-puja.in/$1",
      "permanent": true
    }
  ]
}
